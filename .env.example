# Скопируйте файл в .env и выполните ./setup.sh, чтобы сгенерировать SECRET_KEY.
# Не коммитьте рабочий .env и реальные секреты.

# Основные настройки
SECRET_KEY=
APP_URL=https://lk.silaeder.ru
# Дополнительные frontend-origin через запятую; по умолчанию разрешён только APP_URL.
CORS_ORIGINS=
# Отображаемое имя сервиса в интерфейсе и письмах. Во frontend подставляется при сборке.
APP_NAME=Силаэдр CRM

# Необязательный мастер-пароль. Пустое значение отключает его.
MASTER_PASSWORD=

# Почта
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@lk.silaeder.ru

# Redis: отдельные logical DB для очереди, результатов Celery и rate limit.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/1
RATELIMIT_STORAGE_URI=redis://redis:6379/2

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TOKEN_EXPIRES=600
TELEGRAM_POLL_TIMEOUT=30

# Необязательный SOCKS5 proxy. socks5h также проксирует DNS-запросы.
# TELEGRAM_PROXY_URL=socks5h://user:password@proxy.example.org:1080

# OIDC. Пустой issuer автоматически берётся из APP_URL.
OIDC_ISSUER=
OIDC_KEY_PATH=/app/storage/oidc_signing_key.pem
OIDC_AUTH_CODE_EXPIRES=300
OIDC_ACCESS_TOKEN_EXPIRES=900
OIDC_ID_TOKEN_EXPIRES=900
OIDC_REFRESH_TOKEN_EXPIRES=2592000

# Внешний reverse proxy на хосте + nginx из compose.yml.
TRUSTED_PROXY_COUNT=2

# Rate limit с учётом общего школьного внешнего IP.
AUTH_LOGIN_IP_RATE_LIMIT="2000 per hour"
AUTH_LOGIN_EMAIL_RATE_LIMIT="10 per minute; 50 per hour"
AUTH_SIGNUP_IP_RATE_LIMIT="1000 per hour"
AUTH_SIGNUP_INVITE_RATE_LIMIT="20 per hour"
AUTH_PASSWORD_EMAIL_IP_RATE_LIMIT="500 per hour"
AUTH_PASSWORD_EMAIL_RATE_LIMIT="3 per hour"
AUTH_PASSWORD_RESET_IP_RATE_LIMIT="500 per hour"
AUTH_PASSWORD_RESET_TOKEN_RATE_LIMIT="10 per hour"

# Срок постоянной браузерной сессии при отмеченном «Не выходить из системы».
AUTH_REFRESH_TOKEN_EXPIRES_DAYS=30

# Резервные копии в S3-совместимое хранилище
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ru-central1
S3_ENDPOINT_URL=https://storage.example.org
S3_BUCKET_NAME=
